# Copy this file to .env and fill in your own values.
# .env is gitignored — never commit real secrets.

# Required for real document extraction (GPT-4.1-mini). Without this set,
# uploads still work end-to-end but fall back to local/deterministic
# parsing in the browser instead of AI extraction.
OPENAI_API_KEY=sk-...

# Optional — defaults shown below, only set if you need to override.
# OPENAI_MODEL=gpt-4.1-mini
# PORT=4000
# DATABASE_URL=postgresql://devteam:D3vteaM%2321@172.16.1.30:5432/VMP-POC

# Alternative to OPENAI_API_KEY: point extraction at a model you deployed
# yourself in Microsoft Foundry (not the "agent" flow below — a plain chat
# model deployment). Fill in from that deployment's Endpoint/Key screen. When
# set, these take priority over OPENAI_API_KEY and OPENAI_MODEL — both
# code-interpreter and formula-plan modes run unchanged, just against this
# endpoint instead of api.openai.com. (code-interpreter needs the Responses
# API's code_interpreter tool, which not every Foundry deployment supports —
# if it errors, formula-plan mode works against any OpenAI-compatible chat
# completions endpoint and is the more reliable mode anyway.)
# FOUNDRY_OPENAI_ENDPOINT=https://<your-resource>.services.ai.azure.com/openai/v1/
# FOUNDRY_OPENAI_API_KEY=...
# FOUNDRY_OPENAI_MODEL=<your deployment name>

# Required only for "Microsoft Foundry Agent" mode (the 3rd, optional
# extraction path — the default two modes don't need any of this). Left in
# place but not recommended: live testing showed it miscounting large-row-
# count sums by 4x-30x on multi-file payroll data — prefer the model-
# deployment option above instead.
# FOUNDRY_ENDPOINT=https://dfm-foundry.services.ai.azure.com/api/projects/dfm-foundry
# FOUNDRY_AGENT_NAME=excel-reader
# FOUNDRY_AGENT_VERSION=3
# FOUNDRY_PYTHON_BIN=python
#
# Auth — simplest option: a key from the Foundry resource's "Keys and
# Endpoint" page in the portal (either key works). When set, this bypasses
# Azure AD entirely — no service principal or `az login` needed.
# FOUNDRY_API_KEY=...
#
# Alternative: Azure AD, if you'd rather not use a long-lived key. Leave
# FOUNDRY_API_KEY unset and provide a service principal instead (create one
# with `az ad sp create-for-rbac`, then grant it access to the AI Foundry
# project) — DefaultAzureCredential picks these up automatically:
# AZURE_TENANT_ID=0bc5d808-334f-4d31-91c8-2bcc172f3d48
# AZURE_CLIENT_ID=...
# AZURE_CLIENT_SECRET=...
# (or, for local/manual testing only: install the Azure CLI and run
# `az login --tenant <tenant id>` — DefaultAzureCredential picks that up too.)
